<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Categorized API Test Results</title>
<style>
  body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; margin: 40px; line-height: 1.6; }
  h1 { color: #1e3a8a; border-bottom: 2px solid #3b82f6; padding-bottom: 10px; margin-bottom: 30px; }
  h2 { color: #2563eb; margin-top: 40px; border-left: 5px solid #2563eb; padding-left: 15px; }
  .api-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin-bottom: 20px; background-color: #f9fafb; }
  .method { font-weight: bold; padding: 4px 8px; border-radius: 4px; color: white; display: inline-block; margin-right: 10px; font-family: sans-serif; font-size: 12px; }
  .GET { background-color: #10b981; }
  .POST { background-color: #3b82f6; }
  .PUT { background-color: #f59e0b; }
  .DELETE { background-color: #ef4444; }
  .PATCH { background-color: #8b5cf6; }
  .url { font-family: monospace; font-size: 14px; color: #4b5563; }
  .status-success { color: #059669; font-weight: bold; margin-top: 10px; font-family: sans-serif; font-size: 14px; }
  .status-error { color: #dc2626; font-weight: bold; margin-top: 10px; font-family: sans-serif; font-size: 14px; }
  pre { background-color: #1f2937; color: #f9fafb; padding: 15px; border-radius: 6px; font-family: monospace; overflow-x: auto; margin-top: 10px; font-size: 12px; }
</style>
</head>
